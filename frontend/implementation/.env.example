# Sketchbook Universe - public build-time configuration.
# EVERYTHING here is NEXT_PUBLIC_*: it is inlined into the public JavaScript bundle of this
# static export. NEVER put API keys, tokens, cookies or passwords in this file or in any
# NEXT_PUBLIC_* variable. Partner values below are placeholders: nothing is agreed yet.
# Reference: docs/execution/PARTNER_CONTRACT_ACTUAL.md

# --- Prediction provider -------------------------------------------------------
# Default: whole demo runs locally with MOCK Top-3 fixtures (labelled DEV / MOCK).
NEXT_PUBLIC_PREDICTION_MODE=mock

# Enable ONLY after the partner endpoint contract is agreed. Any value other than
# mock|partner, or partner without a valid http(s) endpoint, makes every prediction
# fail loudly (it never falls back to mock output).
# NEXT_PUBLIC_PREDICTION_MODE=partner
# NEXT_PUBLIC_PREDICTION_ENDPOINT=https://endpoint-partner.example/predict
# NEXT_PUBLIC_PREDICTION_TIMEOUT_MS=8000

# PROPOSED (partner has not agreed; defaults shown):
# NEXT_PUBLIC_PREDICTION_OOV_POLICY=allow         # allow | reject (reject => 'out-of-vocabulary' error + redraw/retry)
# NEXT_PUBLIC_PREDICTION_SEND_CONTEXT=0           # 1 => add levelId/attemptId/contractVersion + X-Contract-Version
# NON-SECRET extra request headers only; credential-like names/values are refused:
# NEXT_PUBLIC_PREDICTION_HEADERS_JSON={"X-Contract-Version":"1.0.0-draft"}

# --- Interaction event logging (DRAFT; nothing is sent unless an endpoint is set) --
# NEXT_PUBLIC_EVENT_ENDPOINT=https://logging-partner.example/ingest
# NEXT_PUBLIC_EVENT_BATCH_SIZE=20
# NEXT_PUBLIC_EVENT_FLUSH_INTERVAL_MS=5000
# NEXT_PUBLIC_EVENT_CONSOLE=0                     # 1 => console sink also in production builds
# OPT-IN, default OFF (identifies a student; no consent/PII policy agreed yet):
# NEXT_PUBLIC_EVENT_INCLUDE_STUDENT_NUMBER=0

# --- Other (existing) ----------------------------------------------------------------
# NEXT_PUBLIC_DRAW_INPUT_MODE=pointer
# NEXT_PUBLIC_MEDIAPIPE_MODEL_URL=/models/hand_landmarker.task
# E2E only: NEXT_PUBLIC_TEST_HOOKS=1
