logs/
*.log

# Data files (keep raw data out of VCS)
data/
*.csv
*.tsv
*.json
*.sqlite
# ...except frontend config (package.json, tsconfig.json, etc.)
!frontend/**/*.json

# Model checkpoints / artifacts
checkpoints/
models/
# ...except the MediaPipe hand model the game serves to the browser
!frontend/implementation/public/models/
*.pth
*.pt
# Model backups made before retraining (see DEPLOY.md)
weights/backup/

# Local tools / binaries (download cloudflared separately, see backend/README.md)
cloudflared.exe
cloudflared

# Browser test recordings from the frontend's E2E runs (kept in the hitl-momo repo)
frontend/implementation/docs/evidence/videos/
frontend/implementation/docs/**/*.webm
frontend/implementation/docs/**/*.mp4

# Temporary files
*.tmp
*.swp
*~

# Home dir used by train/train_in_docker.sh (pip/keras caches)
.train-home/

# Home dir used by train/evaluate_in_docker.sh
.eval-home/
