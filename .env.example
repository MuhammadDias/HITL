# Docker deployment settings. Copy to .env and edit:  cp .env.example .env
# After changing PUBLIC_URL, rebuild:  docker compose up -d --build

# Address students and teachers open in the browser (no trailing slash).
#   With a domain:   PUBLIC_URL=https://momominum.tech
#   With an IP only: PUBLIC_URL=http://203.0.113.10
PUBLIC_URL=http://localhost

# What Caddy listens on.
#   With a domain:   SITE_ADDRESS=momominum.tech   (automatic HTTPS)
#   With an IP only: SITE_ADDRESS=:80              (plain HTTP)
SITE_ADDRESS=:80

# Optional
# HTTP_PORT=80
# HTTPS_PORT=443
# DRAW_INPUT_MODE=pointer        # or "hand" (camera; needs HTTPS)

# Model file in weights/ used by the backend (change, then: docker compose restart backend)
# MODEL_FILE=model_4_mobilenetv2_best.keras
